# Local development: http://localhost:8000
# Vercel production: replace with the public HTTPS URL of the deployed API.
# Do not use localhost here: it would point to each visitor's own device.
VITE_API_BASE_URL=http://localhost:8000
INVENTORY_DATABASE_URL=postgresql+asyncpg://inventory:inventory@db:5432/inventory
# Fill Rate module's own database - a second, genuinely separate database on the
# same Postgres container (created via docker/initdb.d), not a shared schema.
FILL_RATE_DATABASE_URL=postgresql+asyncpg://inventory:inventory@db:5432/fill_rate_db
